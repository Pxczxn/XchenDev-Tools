# ============================================================
# 原则：只提交项目源码 + 正式插图；其余忽略
#
# 插图 vs 原型图：只按路径判断
# 插图路径（提交）：public/images/、public/brand/、src/assets/、static/
# 原型路径（忽略）：.prototype-review/、prototype-assets/、prototype-specs/
# ============================================================

# 依赖
node_modules/

# 构建产物
dist/
dist-ssr/
*.local

# Rust / Tauri（src-tauri/.gitignore 另管 /target/、/gen/schemas）
src-tauri/target/

# 缓存与测试输出
coverage/

# 运行时与临时文件
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 本地环境与密钥
.env
.env.*
!.env.example

# 本地运行时配置（默认同目录 config/config.json）
config/config.json

# IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# AI / Agent 产出
.agents/
.agent/
.codex/
.claude/
.cursor/
.reasonix/
.workbuddy/
rollout-*.jsonl
.codex-*.png

# 原型路径（忽略）
.prototype-review/
prototype/
prototypes/
prototype-specs/
prototype-assets/
mockup/
wireframe/
figma/
design/

# 开发资料
docs/
doc/
*.md
!/README.md

# 操作系统
.DS_Store
Thumbs.db
Desktop.ini
